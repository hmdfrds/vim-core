[
  {
    "pattern": "[a-z]\\+",
    "magic_mode": "magic",
    "input": "Hello World",
    "expected_matches": [
      {"start": 1, "end": 5},
      {"start": 7, "end": 11}
    ],
    "source": "neovim-oracle-v0.10.0"
  },
  {
    "pattern": "[^a-z]\\+",
    "magic_mode": "magic",
    "input": "Hello World",
    "expected_matches": [
      {"start": 0, "end": 1},
      {"start": 5, "end": 7}
    ],
    "source": "neovim-oracle-v0.10.0"
  },
  {
    "pattern": "[0-9a-f]\\+",
    "magic_mode": "magic",
    "input": "deadbeef 0x1F",
    "expected_matches": [
      {"start": 0, "end": 8},
      {"start": 9, "end": 10},
      {"start": 11, "end": 12}
    ],
    "source": "neovim-oracle-v0.10.0"
  },
  {
    "pattern": "[[:alpha:]]\\+",
    "magic_mode": "magic",
    "input": "abc 123 def",
    "expected_matches": [
      {"start": 0, "end": 3},
      {"start": 8, "end": 11}
    ],
    "source": "neovim-oracle-v0.10.0"
  },
  {
    "pattern": "[[:digit:]]\\+",
    "magic_mode": "magic",
    "input": "abc 123 def",
    "expected_matches": [
      {"start": 4, "end": 7}
    ],
    "source": "neovim-oracle-v0.10.0"
  }
]
